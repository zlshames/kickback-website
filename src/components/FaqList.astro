---
import type { Faq } from '../data/site';
interface Props { items: Faq[] }
const { items } = Astro.props;
---
<div class="faq-list">
  {items.map((f) => (
    <details class="faq" data-faq>
      <summary>
        <span>{f.q}</span>
        <i aria-hidden="true"></i>
      </summary>
      <div class="a"><p>{f.a}</p></div>
    </details>
  ))}
</div>

<style>
  .faq-list { display: grid; gap: 10px; }
  .faq { border: 1px solid var(--line); border-radius: 20px; background: var(--surface); transition: background 0.3s, border-color 0.3s; }
  .faq[open] { background: var(--surface-2); border-color: var(--line-2); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 20px 24px; cursor: pointer; list-style: none; font-weight: 620; font-size: 1.06rem; letter-spacing: -0.012em; }
  summary::-webkit-details-marker { display: none; }
  summary i { position: relative; flex: none; width: 28px; height: 28px; border-radius: 50%; background: rgba(255, 255, 255, 0.08); transition: transform 0.4s var(--ease), background 0.3s; }
  summary i::before, summary i::after { content: ''; position: absolute; left: 50%; top: 50%; width: 11px; height: 1.8px; background: #fff; border-radius: 2px; translate: -50% -50%; }
  summary i::after { rotate: 90deg; transition: rotate 0.4s var(--ease); }
  .faq[open] summary i { background: var(--accent); transform: rotate(180deg); }
  .faq[open] summary i::before, .faq[open] summary i::after { background: #06070b; }
  .faq[open] summary i::after { rotate: 0deg; }
  .a { padding: 0 24px 22px; color: #c0c4d0; max-width: 68ch; }
  .faq[open] .a { animation: open 0.45s var(--ease); }
  @keyframes open { from { opacity: 0; transform: translateY(-6px); } }
</style>
