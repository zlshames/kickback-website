---
// The hero: a working miniature of the launcher and the phone remote.
// Tile rendering follows mac/Kickback/Views/TileView.swift: a two-color gradient,
// the icon blurred behind itself, and a focused card that lifts, tilts and catches light.
import Icon from './Icon.astro';
import safari from '../assets/tiles/safari.png';
import tv from '../assets/tiles/tv.png';
import music from '../assets/tiles/music.png';
import photos from '../assets/tiles/photos.png';
import podcasts from '../assets/tiles/podcasts.png';
import youtube from '../assets/tiles/youtube.png';
import netflix from '../assets/tiles/netflix.png';
import twitch from '../assets/tiles/twitch.png';
import wikipedia from '../assets/tiles/wikipedia.png';
import shortcuts from '../assets/tiles/shortcuts.png';

type Tile = { id: string; title: string; kind: string; c: [string, string]; icon: ImageMetadata; app: boolean; profile: 'video' | 'music' | 'browser' | 'app' | 'shortcut' };
const rows: { name: string; tiles: Tile[] }[] = [
  {
    name: 'Apps',
    tiles: [
      { id: 'safari', title: 'Safari', kind: 'App', c: ['#048ffe', '#01acfe'], icon: safari, app: true, profile: 'browser' },
      { id: 'tv', title: 'TV', kind: 'App', c: ['#2a2a2c', '#111112'], icon: tv, app: true, profile: 'video' },
      { id: 'music', title: 'Music', kind: 'App', c: ['#f80135', '#f82c56'], icon: music, app: true, profile: 'music' },
      { id: 'photos', title: 'Photos', kind: 'App', c: ['#fe9007', '#03a8ed'], icon: photos, app: true, profile: 'app' },
      { id: 'podcasts', title: 'Podcasts', kind: 'App', c: ['#8936b4', '#a855d3'], icon: podcasts, app: true, profile: 'music' },
    ],
  },
  {
    name: 'Links',
    tiles: [
      { id: 'youtube', title: 'YouTube', kind: 'youtube.com', c: ['#ff5c7a', '#d9c9c9'], icon: youtube, app: false, profile: 'video' },
      { id: 'netflix', title: 'Netflix', kind: 'netflix.com', c: ['#b10610', '#e40914'], icon: netflix, app: false, profile: 'video' },
      { id: 'twitch', title: 'Twitch', kind: 'twitch.tv', c: ['#6342a5', '#9983c4'], icon: twitch, app: false, profile: 'video' },
      { id: 'wikipedia', title: 'Wikipedia', kind: 'wikipedia.org', c: ['#6a6a6e', '#353537'], icon: wikipedia, app: false, profile: 'browser' },
    ],
  },
  {
    name: 'Shortcuts',
    tiles: [
      { id: 'morning', title: 'Good Morning', kind: 'Shortcut', c: ['#48dbfb', '#0a7de3'], icon: shortcuts, app: true, profile: 'shortcut' },
      { id: 'lights', title: 'Lights Off', kind: 'Shortcut', c: ['#ffb02e', '#ff5a3d'], icon: shortcuts, app: true, profile: 'shortcut' },
    ],
  },
];
const actions = [
  { id: 'ask', label: 'Ask', icon: 'sparkles' },
  { id: 'add-app', label: 'Add App', icon: 'plus' },
  { id: 'add-link', label: 'Add Link', icon: 'link' },
  { id: 'settings', label: 'Settings', icon: 'grid' },
];
---
<div class="stage" data-demo tabindex="0" aria-label="Interactive demo: a Kickback launcher on a TV with a phone remote. Use the arrow keys to move, Return to open, Escape to go back.">
  <div class="tv" data-tv>
    <div class="ambient" aria-hidden="true"></div>
    <div class="bezel">
      <div class="tvscreen" data-screen>
        <div class="scroller" data-scroller>
          <div class="shelf">
            <div class="shelf-art" aria-hidden="true"><img data-shelf-img src={music.src} alt="" /></div>
            <div class="shelf-text">
              <div class="shelf-title" data-shelf-title>Music</div>
              <div class="shelf-sub" data-shelf-sub>App</div>
            </div>
          </div>
          {rows.map((row, r) => (
            <section class="row-block">
              <h3 class="row-name">{row.name}</h3>
              <div class="row" data-row={r}>
                {row.tiles.map((t) => (
                  <button
                    class:list={['tile', { app: t.app }]}
                    tabindex="-1"
                    data-tile={t.id}
                    data-title={t.title}
                    data-kind={t.kind}
                    data-profile={t.profile}
                    data-icon={t.icon.src}
                    style={`--c1:${t.c[0]};--c2:${t.c[1]}`}
                  >
                    <span class="card-face">
                      <span class="face-bg"><img src={t.icon.src} alt="" loading="eager" /></span>
                      <img class="face-icon" src={t.icon.src} alt="" loading="eager" />
                      <span class="spec"></span>
                    </span>
                    <span class="tile-title">{t.title}</span>
                  </button>
                ))}
              </div>
            </section>
          ))}
          <div class="row actions" data-row={rows.length}>
            {actions.map((a) => (
              <button class="pill" tabindex="-1" data-action={a.id} data-title={a.label}>
                <Icon name={a.icon} size={16} /> {a.label}
              </button>
            ))}
          </div>
        </div>
        <div class="clock" aria-hidden="true">9:41 AM</div>

        <div class="appview" data-appview aria-live="polite">
          <img class="app-icon" data-app-icon alt="" />
          <div class="app-name" data-app-name></div>
          <div class="app-status" data-app-status></div>
          <div class="app-bar" data-app-bar><i></i></div>
          <div class="app-hint">Back or Home on the remote returns to Kickback</div>
        </div>
        <div class="toast" data-toast></div>
      </div>
    </div>
    <div class="stand" aria-hidden="true"></div>
  </div>

  <div class="remote" data-remote>
    <div class="phone">
      <div class="screen rs">
        <div class="r-status"><span>9:41</span><span class="r-sig"><i></i><i></i><i></i><i></i></span></div>
        <div class="r-head">
          <Icon name="wifi" size={16} class="r-wifi" />
          <strong>Living Room</strong>
          <span class="r-round"><Icon name="sparkles" size={14} /></span>
          <span class="r-round"><Icon name="tabs" size={14} /></span>
        </div>
        <div class="r-tabs"><b>Remote</b><span>Trackpad</span><span>Apps</span><span>Controls</span></div>
        <div class="r-context"><Icon name="tv" size={12} /> <span data-context>Kickback home</span></div>
        <div class="r-pad" data-pad>
          <span class="r-pad-hint" data-pad-hint>Swipe to move · Tap to select</span>
          <span class="r-finger" data-finger></span>
        </div>
        <div class="r-buttons">
          <button data-btn="back" aria-label="Back"><span><Icon name="arrow-left" size={18} /></span>Back</button>
          <button data-btn="home" aria-label="Home"><span><Icon name="tv" size={18} /></span>Home</button>
          <button data-btn="none" aria-label="Keyboard" tabindex="-1"><span><Icon name="keyboard" size={18} /></span>Keyboard</button>
          <button data-btn="none" aria-label="Hold to talk" tabindex="-1"><span><Icon name="mic" size={18} /></span>Talk</button>
        </div>
        <div class="r-media">
          <button data-btn="left" aria-label="Previous"><Icon name="skip-back" size={15} /></button>
          <button class="big" data-btn="select" aria-label="Play or pause"><Icon name="play" size={19} /></button>
          <button data-btn="right" aria-label="Next"><Icon name="skip-fwd" size={15} /></button>
          <span class="r-vol"><Icon name="volume" size={15} /><Icon name="minus" size={13} /><Icon name="plus" size={13} /></span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  type Dir = 'up' | 'down' | 'left' | 'right';
  const stage = document.querySelector<HTMLElement>('[data-demo]');
  if (stage) {
    const tvEl = stage.querySelector<HTMLElement>('[data-tv]')!;
    const screen = stage.querySelector<HTMLElement>('[data-screen]')!;
    const scroller = stage.querySelector<HTMLElement>('[data-scroller]')!;
    const rows = [...stage.querySelectorAll<HTMLElement>('[data-row]')].map((r) => [...r.querySelectorAll<HTMLElement>('button')]);
    const shelfTitle = stage.querySelector<HTMLElement>('[data-shelf-title]')!;
    const shelfSub = stage.querySelector<HTMLElement>('[data-shelf-sub]')!;
    const shelfImg = stage.querySelector<HTMLImageElement>('[data-shelf-img]')!;
    const appview = stage.querySelector<HTMLElement>('[data-appview]')!;
    const appIcon = stage.querySelector<HTMLImageElement>('[data-app-icon]')!;
    const appName = stage.querySelector<HTMLElement>('[data-app-name]')!;
    const appStatus = stage.querySelector<HTMLElement>('[data-app-status]')!;
    const appBar = stage.querySelector<HTMLElement>('[data-app-bar]')!;
    const toast = stage.querySelector<HTMLElement>('[data-toast]')!;
    const context = stage.querySelector<HTMLElement>('[data-context]')!;
    const pad = stage.querySelector<HTMLElement>('[data-pad]')!;
    const padHint = stage.querySelector<HTMLElement>('[data-pad-hint]')!;
    const finger = stage.querySelector<HTMLElement>('[data-finger]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let row = 0, col = 2;
    let launched: HTMLElement | null = null;
    let playing = true;
    let interacted = false;
    let toastTimer = 0;

    const current = () => rows[row][col];

    function showToast(text: string) {
      toast.textContent = text;
      toast.classList.add('on');
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toast.classList.remove('on'), 1300);
    }

    function focus(r: number, c: number) {
      current().classList.remove('focus');
      row = Math.max(0, Math.min(rows.length - 1, r));
      col = Math.max(0, Math.min(rows[row].length - 1, c));
      const el = current();
      el.classList.add('focus');
      el.style.setProperty('--tx', '0');
      el.style.setProperty('--ty', '0');
      if (el.dataset.tile) {
        shelfTitle.textContent = el.dataset.title!;
        shelfSub.textContent = el.dataset.kind!;
        shelfImg.src = el.dataset.icon!;
        tvEl.style.setProperty('--glow', getComputedStyle(el).getPropertyValue('--c1').trim());
      }
      // Keep the focused row in view, the way the launcher scrolls.
      const h = screen.clientHeight;
      // The shelf and the first two rows fit on one screen; anything lower scrolls to the end.
      const max = Math.max(0, scroller.scrollHeight - h);
      scroller.style.transform = `translate3d(0, ${row <= 1 ? 0 : -max}px, 0)`;
    }

    function setContext() {
      context.textContent = launched ? launched.dataset.title! : 'Kickback home';
      const p = launched?.dataset.profile;
      padHint.textContent = !launched
        ? 'Swipe to move · Tap to select'
        : p === 'video' ? 'Tap to play/pause · Swipe to seek'
        : p === 'music' ? 'Tap to play/pause · Swipe for tracks'
        : p === 'browser' ? 'Swipe for back and forward'
        : 'Swipe to move · Tap to select';
    }

    function launch(el: HTMLElement) {
      if (el.dataset.profile === 'shortcut') {
        showToast(`Running “${el.dataset.title}”…`);
        window.setTimeout(() => showToast(`“${el.dataset.title}” finished`), 1400);
        return;
      }
      launched = el;
      playing = true;
      const cs = getComputedStyle(el);
      appview.style.setProperty('--c1', cs.getPropertyValue('--c1'));
      appview.style.setProperty('--c2', cs.getPropertyValue('--c2'));
      appIcon.src = el.dataset.icon!;
      appIcon.classList.toggle('fav', !el.classList.contains('app'));
      appName.textContent = el.dataset.title!;
      const p = el.dataset.profile;
      appStatus.textContent = p === 'video' || p === 'music' ? 'Playing' : 'Open on your Mac';
      appBar.hidden = !(p === 'video' || p === 'music');
      appBar.classList.remove('paused');
      appview.classList.add('on');
      setContext();
    }

    function close() {
      if (!launched) return;
      launched = null;
      appview.classList.remove('on');
      setContext();
    }

    function nav(dir: Dir) {
      if (launched) {
        const p = launched.dataset.profile;
        if (p === 'video') { if (dir === 'left') showToast('−10 s'); else if (dir === 'right') showToast('+10 s'); }
        else if (p === 'music') { if (dir === 'left') showToast('Previous track'); else if (dir === 'right') showToast('Next track'); }
        else if (p === 'browser') { if (dir === 'left') showToast('Back'); else if (dir === 'right') showToast('Forward'); }
        return;
      }
      if (dir === 'left') focus(row, col - 1);
      else if (dir === 'right') focus(row, col + 1);
      else if (dir === 'up') focus(row - 1, col);
      else focus(row + 1, col);
    }

    function select() {
      if (launched) {
        const p = launched.dataset.profile;
        if (p === 'video' || p === 'music') {
          playing = !playing;
          appStatus.textContent = playing ? 'Playing' : 'Paused';
          appBar.classList.toggle('paused', !playing);
        }
        return;
      }
      const el = current();
      if (el.dataset.tile) launch(el);
      else showToast(el.dataset.title === 'Ask' ? '“Put on Netflix and dim the screen”' : el.dataset.title!);
    }

    function touch() { interacted = true; }

    // --- TV: mouse ---
    rows.flat().forEach((el) => {
      el.addEventListener('click', () => {
        touch();
        const r = rows.findIndex((x) => x.includes(el));
        const c = rows[r].indexOf(el);
        if (el === current()) select(); else focus(r, c);
      });
    });
    screen.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' || launched) return;
      const b = screen.getBoundingClientRect();
      const el = current();
      el.style.setProperty('--tx', (((e.clientX - b.left) / b.width) * 2 - 1).toFixed(3));
      el.style.setProperty('--ty', (((e.clientY - b.top) / b.height) * 2 - 1).toFixed(3));
    });
    screen.addEventListener('pointerleave', () => {
      current().style.setProperty('--tx', '0');
      current().style.setProperty('--ty', '0');
    });
    appview.addEventListener('click', () => { touch(); select(); });

    // --- Remote: swipe pad ---
    let start: { x: number; y: number } | null = null;
    let stepped = false;
    const STEP = 34;
    pad.addEventListener('pointerdown', (e) => {
      touch();
      pad.setPointerCapture(e.pointerId);
      start = { x: e.clientX, y: e.clientY };
      stepped = false;
      pad.classList.add('touching');
      moveFinger(e);
    });
    function moveFinger(e: PointerEvent) {
      const b = pad.getBoundingClientRect();
      const x = Math.max(0, Math.min(1, (e.clientX - b.left) / b.width));
      const y = Math.max(0, Math.min(1, (e.clientY - b.top) / b.height));
      finger.style.left = `${x * 100}%`;
      finger.style.top = `${y * 100}%`;
      if (!launched) {
        current().style.setProperty('--tx', (x * 2 - 1).toFixed(3));
        current().style.setProperty('--ty', (y * 2 - 1).toFixed(3));
      }
    }
    pad.addEventListener('pointermove', (e) => {
      if (!start) return;
      moveFinger(e);
      const dx = e.clientX - start.x, dy = e.clientY - start.y;
      if (Math.abs(dx) > STEP || Math.abs(dy) > STEP) {
        nav(Math.abs(dx) > Math.abs(dy) ? (dx > 0 ? 'right' : 'left') : dy > 0 ? 'down' : 'up');
        start = { x: e.clientX, y: e.clientY };
        stepped = true;
      }
    });
    const endTouch = (e: PointerEvent) => {
      if (!start) return;
      const moved = Math.hypot(e.clientX - start.x, e.clientY - start.y);
      if (!stepped && moved < 8 && e.type === 'pointerup') select();
      start = null;
      pad.classList.remove('touching');
      if (!launched) { current().style.setProperty('--tx', '0'); current().style.setProperty('--ty', '0'); }
    };
    pad.addEventListener('pointerup', endTouch);
    pad.addEventListener('pointercancel', endTouch);

    // --- Remote: buttons ---
    stage.querySelectorAll<HTMLElement>('[data-btn]').forEach((b) => {
      b.addEventListener('click', () => {
        touch();
        const k = b.dataset.btn;
        if (k === 'back' || k === 'home') { if (launched) close(); else if (k === 'home') focus(0, 0); }
        else if (k === 'select') select();
        else if (k === 'left' || k === 'right') nav(k);
      });
    });

    // --- Keyboard: only while the demo is hovered or focused, so the page still scrolls normally ---
    document.addEventListener('keydown', (e) => {
      if (!(stage.matches(':hover') || stage.contains(document.activeElement))) return;
      const map: Record<string, Dir> = { ArrowUp: 'up', ArrowDown: 'down', ArrowLeft: 'left', ArrowRight: 'right' };
      if (map[e.key]) { e.preventDefault(); touch(); nav(map[e.key]); }
      else if (e.key === 'Enter' || e.key === ' ') {
        if ((e.target as HTMLElement).closest('[data-btn]')) return; // let a focused remote button click itself
        e.preventDefault(); touch(); select();
      } else if (e.key === 'Escape' || e.key === 'Backspace') { if (launched) { e.preventDefault(); touch(); close(); } }
    });

    // --- Idle tour until someone takes over ---
    const tour: (Dir | 'select' | 'back')[] = ['right', 'right', 'down', 'left', 'left', 'left', 'select', 'back', 'right', 'up', 'left', 'right'];
    let step = 0;
    let visible = false;
    new IntersectionObserver((es) => { visible = es[0].isIntersecting; }, { threshold: 0.35 }).observe(stage);
    if (!reduced) {
      window.setInterval(() => {
        if (interacted || !visible || document.hidden) return;
        const a = tour[step++ % tour.length];
        if (a === 'select') select(); else if (a === 'back') close(); else nav(a);
      }, 1900);
    }

    focus(0, 2);
    window.addEventListener('resize', () => focus(row, col));
  }
</script>

<style>
  .stage { position: relative; width: 100%; max-width: 1080px; margin-inline: auto; outline: none; padding-right: 9%; padding-bottom: 5%; }
  .stage:focus-visible .bezel { box-shadow: 0 0 0 2px var(--accent), 0 60px 120px -40px rgba(0, 0, 0, 0.95); }

  /* ---------- TV ---------- */
  .tv { position: relative; --glow: #f80135; transition: --glow 0.7s var(--ease); }
  .ambient {
    position: absolute; inset: 4% -4% -6%; z-index: -1; border-radius: 40%;
    background: var(--glow); filter: blur(90px); opacity: 0.38;
  }
  .bezel {
    padding: 0.9%; border-radius: 2.2% / 3.4%;
    background: linear-gradient(160deg, #34363f, #0c0d11 30%, #08090c 70%, #25272e);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08), 0 60px 120px -40px rgba(0, 0, 0, 0.95);
  }
  .stand { width: 22%; height: 0; margin: 0 auto; border-bottom: 1.1vw solid transparent; position: relative; }
  .stand::before { content: ''; position: absolute; left: 38%; right: 38%; top: 0; height: clamp(10px, 2.2vw, 28px); background: linear-gradient(90deg, #15161b, #2c2e36, #15161b); }
  .stand::after { content: ''; position: absolute; left: 0; right: 0; top: clamp(10px, 2.2vw, 28px); height: clamp(3px, 0.5vw, 6px); border-radius: 99px; background: linear-gradient(90deg, #1c1d23, #3a3d47, #1c1d23); box-shadow: 0 20px 30px rgba(0, 0, 0, 0.8); }

  .tvscreen {
    container-type: size;
    position: relative; overflow: hidden; aspect-ratio: 16 / 10;
    border-radius: 1.4% / 2.2%;
    background:
      radial-gradient(120% 62% at 38% 0%, color-mix(in srgb, var(--glow) 62%, transparent), transparent 62%),
      radial-gradient(90% 70% at 100% 100%, rgba(74, 58, 140, 0.35), transparent 60%),
      #06070b;
    font-family: var(--font);
    user-select: none; -webkit-user-select: none;
  }
  .scroller { position: absolute; inset: 0 0 auto 0; padding: 0 5cqw 6cqw; transition: transform 0.6s var(--ease); will-change: transform; }

  .shelf { position: relative; height: 19.5cqw; }
  .shelf-art { position: absolute; left: 50%; top: 2cqw; translate: -50% 0; width: 22cqw; height: 13cqw; display: grid; place-items: center; filter: blur(3.2cqw) saturate(1.3); opacity: 0.75; }
  .shelf-art img { width: 11cqw; height: 11cqw; object-fit: contain; }
  .shelf-text { position: absolute; left: -1cqw; bottom: 3.6cqw; }
  .shelf-title { font-size: 2.7cqw; font-weight: 750; letter-spacing: -0.03em; line-height: 1.1; color: rgba(255, 255, 255, 0.86); }
  .shelf-sub { font-size: 1.05cqw; color: rgba(255, 255, 255, 0.5); margin-top: 0.4cqw; }
  .clock { position: absolute; top: 2.4cqw; right: 5cqw; padding: 0.55cqw 1.3cqw; border-radius: 99px; background: rgba(255, 255, 255, 0.12); backdrop-filter: blur(10px); font-size: 1.35cqw; font-weight: 650; letter-spacing: 0.01em; }

  .row-name { font-size: 1.5cqw; font-weight: 650; color: rgba(255, 255, 255, 0.78); margin-bottom: 1.4cqw; letter-spacing: -0.01em; }
  .row { display: grid; grid-template-columns: repeat(5, 1fr); gap: 2.2cqw; margin-bottom: 3.3cqw; }
  .row.actions { display: flex; gap: 1.2cqw; margin: 1cqw 0 0; }

  .tile { position: relative; display: block; text-align: center; perspective: 60cqw; --tx: 0; --ty: 0; cursor: pointer; outline: none; }
  .card-face {
    position: relative; display: grid; place-items: center; overflow: hidden;
    aspect-ratio: 5 / 3; border-radius: 0.75cqw;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08), 0 0.5cqw 0.9cqw rgba(0, 0, 0, 0.3);
    filter: saturate(0.92) brightness(0.92);
    transition: transform 0.45s var(--spring), box-shadow 0.45s var(--ease), filter 0.3s;
    transform-style: preserve-3d;
  }
  .face-bg {
    position: absolute; inset: -8%;
    background: linear-gradient(135deg, color-mix(in srgb, var(--c1) 88%, white), color-mix(in srgb, var(--c2) 72%, black));
    translate: calc(var(--tx) * -2%) calc(var(--ty) * -2%);
    display: grid; place-items: center;
  }
  .face-bg img { width: 100%; height: 100%; object-fit: cover; filter: blur(2cqw); opacity: 0.4; }
  .face-icon {
    position: absolute; inset: 0; margin: auto; height: 50%; width: auto; max-width: none; aspect-ratio: 1; object-fit: contain; border-radius: 22%;
    filter: drop-shadow(0 0.5cqw 0.5cqw rgba(0, 0, 0, 0.35));
    translate: calc(var(--tx) * 3.5%) calc(var(--ty) * 3.5%);
  }
  .tile.app .face-icon { height: 72%; border-radius: 0; }
  .spec {
    position: absolute; inset: 0; opacity: 0; transition: opacity 0.3s; mix-blend-mode: plus-lighter;
    background: radial-gradient(circle at calc(50% - var(--tx) * 60%) calc(10% - var(--ty) * 60%), rgba(255, 255, 255, 0.34), rgba(255, 255, 255, 0.06) 45%, transparent 75%);
  }
  .tile-title {
    position: absolute; left: -20%; right: -20%; top: calc(100% + 1.25cqw);
    font-size: 1.05cqw; font-weight: 650; color: #fff; white-space: nowrap;
    opacity: 0; translate: 0 -0.5cqw; transition: opacity 0.3s, translate 0.4s var(--ease);
  }
