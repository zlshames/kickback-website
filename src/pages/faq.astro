---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import FaqList from '../components/FaqList.astro';
import { site, faqs } from '../data/site';

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.flatMap((g) => g.items).map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base title="FAQ" description={`Answers about ${site.name}: setup, supported Macs and phones, features, privacy and buying.`}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="page-hero">
    <div class="aurora" aria-hidden="true"></div>
    <div class="wrap">
      <span class="eyebrow reveal">FAQ</span>
      <h1 class="display reveal">Questions,<br /><span class="grad">answered.</span></h1>
      <label class="search reveal">
        <Icon name="search" size={19} />
        <input type="search" placeholder="Search the questions" aria-label="Search the questions" data-faq-search autocomplete="off" />
      </label>
    </div>
  </section>

  <section class="wrap layout">
    <nav class="toc" aria-label="Sections">
      {faqs.map((g) => <a href={`#${slug(g.group)}`}>{g.group}</a>)}
    </nav>
    <div class="groups">
      {faqs.map((g) => (
        <section id={slug(g.group)} data-group>
          <h2 class="h3">{g.group}</h2>
          <FaqList items={g.items} />
        </section>
      ))}
      <p class="none" data-none hidden>Nothing matches that. Try another word, or <a href={site.github.issues}>ask on GitHub</a>.</p>
    </div>
  </section>

  <section class="wrap">
    <div class="still card reveal">
      <div>
        <h2 class="h3">Still stuck?</h2>
        <p class="muted">Open an issue on GitHub and a person will answer.</p>
      </div>
      <a class="btn btn-ghost" href={site.github.issues}><Icon name="github" size={18} /> Open an issue</a>
    </div>
  </section>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-faq-search]');
  const none = document.querySelector<HTMLElement>('[data-none]');
  if (input && none) {
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      document.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => {
        let any = false;
        g.querySelectorAll<HTMLDetailsElement>('[data-faq]').forEach((d) => {
          const hit = !q || d.textContent!.toLowerCase().includes(q);
          d.hidden = !hit;
          d.open = !!q && hit;
          if (hit) { any = true; shown++; }
        });
        g.hidden = !any;
      });
      none.hidden = shown > 0;
    });
  }
</script>

<style>
  .search {
    display: flex; align-items: center; gap: 12px; width: min(100%, 520px); margin: 34px auto 0; padding: 0 20px; height: 56px;
    border-radius: 999px; background: var(--surface); border: 1px solid var(--line-2); color: var(--muted);
    backdrop-filter: blur(12px); transition: border-color 0.2s, box-shadow 0.3s;
  }
  .search:focus-within { border-color: var(--accent); box-shadow: 0 0 0 5px rgba(126, 168, 255, 0.16); }
  .search input { flex: 1; background: none; border: 0; outline: 0; color: var(--text); font: inherit; min-width: 0; }
  .search input::placeholder { color: var(--faint); }

  .layout { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: clamp(24px, 5vw, 70px); margin-top: 30px; }
  .toc { position: sticky; top: 100px; align-self: start; display: grid; gap: 2px; }
  .toc a { padding: 8px 14px; border-radius: 12px; color: var(--muted); font-size: 0.95rem; font-weight: 540; transition: color 0.2s, background 0.2s; }
  .toc a:hover { color: #fff; background: var(--surface); }
  .groups { display: grid; gap: 52px; max-width: 800px; }
  .groups section { scroll-margin-top: 100px; }
  .groups h2 { margin-bottom: 18px; }
  .none { color: var(--muted); }
  .none a { color: var(--accent); }
  @media (max-width: 820px) {
    .layout { grid-template-columns: 1fr; }
    .toc { position: static; display: flex; gap: 6px; overflow-x: auto; padding-bottom: 6px; }
    .toc a { white-space: nowrap; background: var(--surface); border: 1px solid var(--line); border-radius: 999px; }
  }

  .still { margin-top: 80px; padding: 30px 34px; display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .still p { margin-top: 4px; }
</style>
