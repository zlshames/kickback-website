---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import macHome from '../assets/shots/mac-home-tv.png';
import macSettings from '../assets/shots/mac-settings.png';
import pControls from '../assets/shots/p-controls.png';
import pApps from '../assets/shots/p-apps.png';

type F = { icon: string; title: string; text: string; tag?: string };
const groups: { id: string; name: string; title: string; intro: string; items: F[] }[] = [
  {
    id: 'launcher', name: 'Launcher', title: 'A home screen for the big screen',
    intro: 'Windowed or edge-to-edge full screen, driven by the remote, the keyboard, a mouse or a game controller.',
    items: [
      { icon: 'grid', title: 'Tiles for apps, links and Shortcuts', text: 'Add any Mac app, any web address or any shortcut. Tiles sit in named rows you can reorder.' },
      { icon: 'sparkles', title: 'Automatic artwork', text: 'App icons, site icons and posters are fetched for you, with matching colors. Prefer your own picture? Set custom artwork per tile.' },
      { icon: 'tv', title: 'Top Shelf', text: 'The tile in focus gets a large title and a soft wash of its colors across the top of the screen.' },
      { icon: 'expand', title: 'Dedicated TV Mode', text: 'Launch at login, stay full screen, make launched apps full screen too, and keep the display awake.' },
      { icon: 'link', title: 'Open links in apps', text: 'Links for Spotify, Apple Music, Apple TV, Podcasts, Maps, Zoom, Slack, Discord and more open in the Mac app when it is installed. You choose app or browser per service.' },
      { icon: 'tabs', title: 'Reuse browser tabs', text: 'A link switches to the tab that already shows it instead of opening a duplicate. Works with Safari, Chrome, Brave, Edge and Vivaldi.', tag: 'Direct' },
      { icon: 'window', title: 'Its own browser window', text: 'By default Kickback keeps a browser window of its own, so your other windows are never switched or navigated.', tag: 'Direct' },
      { icon: 'moon', title: 'Screensaver', text: 'Fades in after a delay you choose, so a paused evening does not burn in.' },
    ],
  },
  {
    id: 'remote', name: 'Remote', title: 'The phone is the remote',
    intro: 'Free for iPhone and Android. It finds your Mac on its own and reconnects by itself.',
    items: [
      { icon: 'pointer', title: 'Swipe pad or D-pad', text: 'Swipe to move, tap to select, hold for tile options. Prefer buttons? Switch to a D-pad.' },
      { icon: 'pointer', title: 'Trackpad', text: 'A real pointer for web pages. The D-pad hides the cursor; the first trackpad touch places it on the focused tile.' },
      { icon: 'keyboard', title: 'Live keyboard', text: 'The keyboard opens when a text field is focused on the Mac. A key strip adds esc, tab and the modifier keys.' },
      { icon: 'mic', title: 'Dictation', text: 'Hold the mic, speak, and let go to send.' },
      { icon: 'play', title: 'A remote per app', text: 'Tailored controls for YouTube, Netflix, Prime Video, Disney+, Hulu, Twitch, Plex, the TV app, IINA, VLC and QuickTime, plus music apps and browsers.' },
      { icon: 'search', title: 'Search and Navigate', text: 'Jump to the search box of whatever is in front, or move a highlight between the things on screen with the D-pad.' },
      { icon: 'layers', title: 'App switcher', text: 'Double-press Home for running apps and open browser tabs. Tap to switch; hold to hide, quit or close a tab.' },
      { icon: 'grid', title: 'Tiles on your phone', text: 'Browse and launch tiles from the Apps tab. Hold to jiggle, drag to reorder, tap − to remove.' },
      { icon: 'zap', title: 'Haptics', text: 'Every control answers with a press-down tap. Turn them off if you would rather not.' },
    ],
  },
  {
    id: 'controls', name: 'Controls', title: 'A control center for the couch',
    intro: 'Everything you would otherwise get up for, on one tab.',
    items: [
      { icon: 'music', title: 'Now Playing', text: 'Artwork, title and artist, a scrubber, ±10 seconds and transport for whatever the Mac is playing.', tag: 'Direct' },
      { icon: 'clapper', title: 'Scenes', text: 'Movie Night, Bedtime and Back to Work are included. Build your own from controls, tiles, links, media keys, window moves, waits and Shortcuts.' },
      { icon: 'timer', title: 'Sleep timer', text: '15 minutes to two hours, or the end of the current track. Then pause, turn off the display, or sleep the Mac, with a warning a minute before.' },
      { icon: 'sun', title: 'System toggles', text: 'Do Not Disturb, Dark Mode, Night Shift, Keep Awake, Full Screen and Mute, with sliders for volume and brightness.' },
      { icon: 'speaker', title: 'Audio output', text: 'Send sound to the Mac speakers, an HDMI TV, AirPods or a USB device.' },
      { icon: 'window', title: 'Window tools', text: 'Left half, right half, fill, center, full screen and minimize. With two displays: move to the next display and toggle mirroring.' },
      { icon: 'power', title: 'Sleep Display and Screen Saver', text: 'One tap each, for when the film is over.' },
    ],
  },
  {
    id: 'phone', name: 'Phone extras', title: 'Your phone and your Mac, on speaking terms',
    intro: 'Small conveniences that add up.',
    items: [
      { icon: 'share', title: 'Share to TV', text: 'Share a link from any app to Kickback and choose Open on Mac or Add as Tile.' },
      { icon: 'clipboard', title: 'Clipboard both ways', text: 'Send your phone clipboard to the Mac or fetch the Mac clipboard. Paste ↑ can press ⌘V for you.' },
      { icon: 'zap', title: 'Wake on LAN', text: 'A sleeping Mac shows a Wake button, and the remote connects when it is up. Available on Android today.' },
      { icon: 'volume', title: 'Volume buttons', text: 'While the remote is open, the phone volume buttons change the Mac volume.' },
      { icon: 'lock', title: 'Lock-screen controls', text: 'Put the Mac Now Playing on your lock screen with play, pause, next and previous.' },
    ],
  },
  {
    id: 'ai', name: 'Apple Intelligence', title: 'Plain words in, real actions out',
    intro: 'Needs macOS 26 or later on Apple silicon. It runs on the Mac, so Android phones get it too.',
    items: [
      { icon: 'sparkles', title: 'Ask', text: '"Put on Netflix and dim the screen." Simple requests run right away; bigger ones show a Run button first.' },
      { icon: 'clapper', title: 'Describe a scene', text: '"Make a scene for game night" drafts a name, icon and steps for you to review and save.' },
      { icon: 'grid', title: 'Organize Tiles', text: 'Suggests clean names, sensible rows and a short description for each tile. Nothing changes until you apply it.' },
      { icon: 'clipboard', title: 'Smart Clipboard', text: 'Send text from your phone and Kickback suggests what to do with it: open a link, show a place in Maps, track a package, check a flight, or search a service you have a tile for.' },
    ],
  },
  {
    id: 'more', name: 'Shortcuts and controllers', title: 'Plays well with others',
    intro: 'If your Mac can do it, a tile can start it.',
    items: [
      { icon: 'layers', title: 'Shortcuts as tiles', text: 'Run any shortcut in the background, with a toast on the Mac and the phone when it finishes or fails. HomeKit scenes, scripts and app actions are one tile away.' },
      { icon: 'gamepad', title: 'Game controllers', text: 'PlayStation, Xbox and MFi controllers navigate the launcher. In other apps only the Home button acts, so games keep the controller.' },
      { icon: 'keyboard', title: 'Keyboard and mouse', text: 'Arrows, Return and Esc work everywhere in the launcher. ⌃⌘F toggles full screen.' },
    ],
  },
  {
    id: 'security', name: 'Connection', title: 'Direct, and encrypted',
    intro: 'No server sits between your phone and your Mac.',
    items: [
      { icon: 'wifi', title: 'Wi-Fi', text: 'Bonjour discovery and a direct WebSocket on your own network.' },
      { icon: 'bluetooth', title: 'Bluetooth LE', text: 'A second route for when Wi-Fi is awkward.' },
      { icon: 'shield', title: 'End-to-end encryption', text: 'X25519 key agreement and ChaCha20-Poly1305, after a 6-digit pairing code shown on the Mac.' },
      { icon: 'lock', title: 'Paired remotes', text: 'Review and remove paired phones in Settings, or switch off new pairings altogether.' },
    ],
  },
];
---
<Base title="Features" description={`Everything ${site.name} can do: the launcher, the phone remote, controls and scenes, Apple Intelligence, Shortcuts and more.`}>
  <section class="page-hero">
    <div class="aurora" aria-hidden="true"></div>
    <div class="wrap">
      <span class="eyebrow reveal">Features</span>
      <h1 class="display reveal">Everything it does.<br /><span class="grad">All of it.</span></h1>
      <p class="lede reveal">{site.name} is small, but it is thorough. Here is the whole list, grouped by where you will find it.</p>
    </div>
  </section>

  <section class="wrap hero-shot reveal">
    <div class="display-frame">
      <Image src={macHome} alt="The Kickback launcher with the TV tile in focus above rows of app and link tiles." widths={[900, 1500, 2400]} sizes="(max-width: 1180px) 94vw, 1140px" loading="eager" quality={82} />
    </div>
    <div class="phone float"><div class="screen"><Image src={pApps} alt="The remote's Apps tab showing the Mac's tiles." widths={[360, 600]} sizes="220px" /></div></div>
  </section>

  <div class="wrap layout">
    <nav class="toc" aria-label="Feature groups">
      {groups.map((g) => <a href={`#${g.id}`}>{g.name}</a>)}
    </nav>
    <div class="groups">
      {groups.map((g) => (
        <section id={g.id}>
          <header class="reveal">
            <span class="eyebrow">{g.name}</span>
            <h2 class="h2 small">{g.title}</h2>
            <p class="lede">{g.intro}</p>
          </header>
          <div class="grid">
            {g.items.map((f, i) => (
              <article class="f reveal" style={`--d:${(i % 3) * 60}ms`}>
                <span class="ic"><Icon name={f.icon} size={20} /></span>
                <h3>{f.title}{f.tag && <em title="In the direct download. Not in the App Store edition.">{f.tag}</em>}</h3>
                <p>{f.text}</p>
              </article>
            ))}
          </div>
          {g.id === 'controls' && (
            <div class="duo reveal">
              <div class="phone"><div class="screen"><Image src={pControls} alt="The Controls tab: scenes, Now Playing, toggles, brightness and volume sliders and audio output." widths={[360, 600]} sizes="240px" /></div></div>
              <div class="display-frame"><Image src={macSettings} alt="Kickback Settings on the Mac." widths={[700, 1200]} sizes="(max-width: 900px) 90vw, 560px" /></div>
            </div>
          )}
        </section>
      ))}
      <p class="foot muted"><em class="tagx">Direct</em> marks features in the direct download that the sandboxed App Store edition leaves out. <a href="/pricing">Compare editions</a>.</p>
    </div>
  </div>

  <section class="wrap">
    <div class="cta card reveal">
      <h2 class="h2 small">Seen enough?</h2>
      <div class="row">
        <a class="btn btn-primary" href="/download"><Icon name="apple" size={18} /> Download for Mac</a>
        <a class="btn btn-ghost" href="/pricing">See pricing</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-shot { position: relative; padding-right: 6%; padding-bottom: 3%; }
  .float { position: absolute; right: 0; bottom: 0; width: 19%; min-width: 120px; }
  .layout { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: clamp(24px, 5vw, 70px); margin-top: clamp(70px, 10vw, 130px); }
  .toc { position: sticky; top: 100px; align-self: start; display: grid; gap: 2px; }
  .toc a { padding: 8px 14px; border-radius: 12px; color: var(--muted); font-size: 0.95rem; font-weight: 540; transition: color 0.2s, background 0.2s; }
  .toc a:hover { color: #fff; background: var(--surface); }
  .groups { display: grid; gap: clamp(80px, 11vw, 130px); }
  .groups section { scroll-margin-top: 100px; }
  .h2.small { font-size: clamp(1.8rem, 3.6vw, 2.7rem); }
  header .lede { margin-top: 14px; font-size: 1.08rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 14px; margin-top: 34px; }
  .f { padding: 24px; border-radius: 22px; background: var(--surface); border: 1px solid var(--line); transition: border-color 0.3s, background 0.3s, transform 0.5s var(--ease), opacity 0.9s var(--ease), filter 0.9s var(--ease); }
  .f:hover { border-color: var(--line-2); background: var(--surface-2); transform: translateY(-3px); }
  .ic { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; margin-bottom: 16px; color: var(--accent); background: rgba(126, 168, 255, 0.12); border: 1px solid rgba(126, 168, 255, 0.2); }
  .f h3 { font-size: 1.06rem; letter-spacing: -0.015em; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .f p { margin-top: 7px; color: var(--muted); font-size: 0.94rem; line-height: 1.5; }
  em, .tagx { font-style: normal; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 2px 8px; border-radius: 999px; color: #d9c8ff; background: rgba(166, 123, 255, 0.16); border: 1px solid rgba(166, 123, 255, 0.3); }
  .duo { display: grid; grid-template-columns: 0.42fr 1fr; gap: clamp(20px, 4vw, 48px); align-items: center; margin-top: 40px; padding: clamp(20px, 4vw, 44px); border-radius: 28px; background: radial-gradient(80% 100% at 50% 0%, rgba(126, 130, 255, 0.16), transparent), var(--surface); border: 1px solid var(--line); }
  .duo .phone { max-width: 240px; justify-self: center; width: 100%; }
  .foot { font-size: 0.88rem; margin-top: -60px; }
  .foot a { color: var(--accent); }
  @media (max-width: 860px) {
    .layout { grid-template-columns: 1fr; }
    .toc { position: static; display: flex; gap: 6px; overflow-x: auto; padding-bottom: 6px; }
    .toc a { white-space: nowrap; background: var(--surface); border: 1px solid var(--line); border-radius: 999px; }
    .duo { grid-template-columns: 1fr; }
  }
  .cta { margin-top: clamp(80px, 10vw, 120px); padding: clamp(36px, 6vw, 64px); display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; background: radial-gradient(70% 140% at 100% 0%, rgba(126, 110, 255, 0.25), transparent 60%), linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02)); }
  .row { display: flex; gap: 12px; flex-wrap: wrap; }
</style>
