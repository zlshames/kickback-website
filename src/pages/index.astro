---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import TVDemo from '../components/TVDemo.astro';
import FaqList from '../components/FaqList.astro';
import { site, pricing, faqs } from '../data/site';

import macHome from '../assets/shots/mac-home-music.png';
import macHomeTv from '../assets/shots/mac-home-tv.png';
import macAsk from '../assets/shots/mac-ask.png';
import macSettings from '../assets/shots/mac-settings.png';
import pRemote from '../assets/shots/p-remote.png';
import pApps from '../assets/shots/p-apps.png';
import pControls from '../assets/shots/p-controls.png';
import pAsk from '../assets/shots/p-ask.png';
import safari from '../assets/tiles/safari.png';
import music from '../assets/tiles/music.png';
import youtube from '../assets/tiles/youtube.png';
import twitch from '../assets/tiles/twitch.png';
import tvIcon from '../assets/tiles/tv.png';
import podcasts from '../assets/tiles/podcasts.png';

const direct = pricing.plans.find((p) => p.featured)!;
const topFaqs = [faqs[0].items[0], faqs[0].items[2], faqs[1].items[0], faqs[3].items[0], faqs[4].items[0]];

const shots = [
  { id: 'home', label: 'Home', img: macHome, alt: 'The Kickback launcher: rows of large tiles for Safari, TV, Music, Photos and Podcasts, with Music in focus and a red glow across the top of the screen.' },
  { id: 'ask', label: 'Ask', img: macAsk, alt: 'The Ask Kickback panel over a blurred launcher, with suggestions such as “Open YouTube and dim the screen”.' },
  { id: 'settings', label: 'Settings', img: macSettings, alt: 'Kickback Settings: Full Screen, Start in Full Screen, Dedicated TV Mode, Display and Screensaver.' },
];

const scenes = [
  { id: 'movie', name: 'Movie Night', icon: 'clapper', color: '#5e5ce6', b: 0.35, warm: 0, steps: ['Do Not Disturb on', 'Brightness to 35%', 'Volume to 60%', 'Keep Awake on', 'Full screen'] },
  { id: 'bed', name: 'Bedtime', icon: 'bed', color: '#ff9f0a', b: 0.2, warm: 1, steps: ['Night Shift on', 'Brightness to 20%', 'Volume to 30%', 'Sleep timer: 30 min'] },
  { id: 'work', name: 'Back to Work', icon: 'briefcase', color: '#30d158', b: 0.8, warm: 0, steps: ['Do Not Disturb off', 'Keep Awake off', 'Leave full screen', 'Brightness to 80%'] },
];

const profiles = [
  { app: 'YouTube', icon: youtube, fav: true, hint: 'Select plays and pauses. Left and right seek.', keys: ['Play/Pause', '−10 s', '+10 s', 'Full Screen', 'Captions'] },
  { app: 'Music', icon: music, fav: false, hint: 'Left and right change track.', keys: ['Play/Pause', 'Previous', 'Next', 'Volume'] },
  { app: 'Safari', icon: safari, fav: false, hint: 'A browser remote, with an address bar.', keys: ['Back', 'Forward', 'Reload', 'Tabs', 'Zoom'] },
];

const more = [
  ['zap', 'Wake on LAN'], ['window', 'Window snapping'], ['speaker', 'Audio output switching'], ['clipboard', 'Clipboard sync'],
  ['layers', 'Shortcuts as tiles'], ['share', 'Share to TV'], ['mic', 'Dictation'], ['lock', 'Lock-screen controls'], ['pointer', 'Trackpad mode'], ['keyboard', 'Live keyboard'],
];
---
<Base>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="aurora" aria-hidden="true"></div>
    <div class="wrap center">
      <a class="announce reveal" href="/download">
        <b>New</b> Version {site.version} for {site.minMacOS} and later <Icon name="arrow-right" size={14} />
      </a>
      <h1 class="display reveal" style="--d:60ms">Your Mac,<br /><span class="grad">made for the couch.</span></h1>
      <p class="lede reveal" style="--d:120ms">
        {site.name} turns any Mac into a living-room TV box: a home screen of beautiful tiles for your apps and streaming sites, and a remote that is already in your pocket.
      </p>
      <div class="cta-row reveal" style="--d:180ms">
        <a class="btn btn-primary" href="/download"><Icon name="apple" size={18} /> Download for Mac</a>
        <a class="btn btn-ghost" href="#tour">See what it does <Icon name="chevron-down" size={16} /></a>
      </div>
      <p class="fine reveal" style="--d:220ms">Free remote for iPhone and Android · No account · No server</p>
    </div>

    <div class="wrap demo reveal" style="--d:260ms">
      <TVDemo />
      <p class="try">
        <span class="live"></span> This one is live.
        <span class="try-mouse">Swipe the remote, click a tile, or hover and use
        <span class="kbd">←</span><span class="kbd">↑</span><span class="kbd">↓</span><span class="kbd">→</span> and <span class="kbd">Return</span>.</span>
        <span class="try-touch">Swipe the remote, or tap a tile twice to open it.</span>
      </p>
    </div>
  </section>

  <!-- ============ FACTS STRIP ============ -->
  <section class="facts wrap" aria-label="At a glance">
    <div class="reveal"><strong>0</strong><span>servers between your phone and your Mac</span></div>
    <div class="reveal" style="--d:70ms"><strong>6</strong><span>digits to pair. No account, ever</span></div>
    <div class="reveal" style="--d:140ms"><strong>2</strong><span>ways to connect: Wi-Fi and Bluetooth LE</span></div>
    <div class="reveal" style="--d:210ms"><strong>1</strong><span>payment. The remote is free</span></div>
  </section>

  <!-- ============ LAUNCHER ============ -->
  <section class="section" id="tour">
    <div class="wrap center">
      <span class="eyebrow reveal">The launcher</span>
      <h2 class="h2 reveal">A home screen worth<br />sitting back for.</h2>
      <p class="lede reveal">
        Apps, websites and Shortcuts become big, focusable tiles you can read from across the room. Artwork and colors are picked up automatically, and the tile in focus lifts, tilts and catches the light.
      </p>
    </div>
    <div class="wrap showcase reveal">
      <div class="shot-tabs" role="tablist" aria-label="Screenshots">
        {shots.map((s, i) => (
          <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-shot-tab={s.id}>{s.label}</button>
        ))}
      </div>
      <div class="display-frame shots" data-shots>
        {shots.map((s, i) => (
          <Image
            src={s.img} alt={s.alt} class:list={[{ on: i === 0 }]} data-shot={s.id}
            widths={[900, 1500, 2400]} sizes="(max-width: 1180px) 94vw, 1140px" loading={i === 0 ? 'eager' : 'lazy'} quality={82}
          />
        ))}
      </div>
      <p class="caption">Real screenshots of {site.name} {site.version} on macOS.</p>
    </div>
    <div class="wrap trio">
      <div class="reveal">
        <Icon name="grid" size={22} />
        <h3 class="h3">Tiles for everything</h3>
        <p class="muted">Mac apps, any web link, and your Shortcuts. Group them into rows, reorder them, and give any tile custom artwork.</p>
      </div>
      <div class="reveal" style="--d:80ms">
        <Icon name="expand" size={22} />
        <h3 class="h3">Dedicated TV Mode</h3>
        <p class="muted">For the Mac mini behind the TV: launch at login, stay full screen, open apps full screen, and keep the display awake.</p>
      </div>
      <div class="reveal" style="--d:160ms">
        <Icon name="tabs" size={22} />
        <h3 class="h3">Links that behave</h3>
        <p class="muted">Links open in the service's own Mac app when you have it. In the browser, {site.name} reuses the tab that is already open instead of piling up new ones.</p>
      </div>
    </div>
  </section>

  <!-- ============ REMOTE ============ -->
  <section class="section remote-sec">
    <div class="wrap split">
      <div class="copy">
        <span class="eyebrow reveal">The remote</span>
        <h2 class="h2 reveal">Already in<br />your pocket.</h2>
        <p class="lede reveal">
          The free remote for iPhone and Android finds your Mac on its own. Swipe to move, tap to select, and reach for a trackpad or keyboard when a web page needs one.
        </p>
        <ul class="ticks">
          <li class="reveal"><Icon name="check" size={18} /> <span><b>Swipe pad or D-pad</b>, with haptics on every press</span></li>
          <li class="reveal"><Icon name="check" size={18} /> <span><b>Trackpad and live keyboard</b>: the keyboard appears when a text field does</span></li>
          <li class="reveal"><Icon name="check" size={18} /> <span><b>Dictation</b>: hold the mic, speak, let go</span></li>
          <li class="reveal"><Icon name="check" size={18} /> <span><b>Your tiles on your phone</b>: launch, add, reorder and remove</span></li>
          <li class="reveal"><Icon name="check" size={18} /> <span><b>Volume buttons and lock screen</b> control the Mac too</span></li>
        </ul>
      </div>
      <div class="phones reveal" aria-label="Screenshots of the remote app">
        <div class="phone p-left"><div class="screen"><Image src={pApps} alt="The remote's Apps tab: a grid of the Mac's tiles, including Safari, TV, Music and Photos." widths={[360, 600]} sizes="260px" /></div></div>
        <div class="phone p-mid"><div class="screen"><Image src={pRemote} alt="The remote's main tab: a large swipe pad above Back, Home, Keyboard and Hold to talk buttons and media keys." widths={[420, 720]} sizes="300px" /></div></div>
        <div class="phone p-right"><div class="screen"><Image src={pControls} alt="The remote's Controls tab: scenes, Now Playing, Do Not Disturb, brightness and volume sliders, and audio output." widths={[360, 600]} sizes="260px" /></div></div>
      </div>
    </div>
  </section>

  <!-- ============ BENTO ============ -->
  <section class="section">
    <div class="wrap center">
      <span class="eyebrow reveal">Everything else</span>
      <h2 class="h2 reveal">It does the fiddly parts,<br />so you stay on the sofa.</h2>
    </div>
    <div class="wrap bento">
      <!-- per-app remote -->
      <article class="card b-profile reveal" data-profiles>
        <div class="b-copy">
          <h3 class="h3">A remote that knows what's on</h3>
          <p class="muted">The remote reshapes itself for whatever is in front on the Mac: video sites and players, music apps, browsers, or any other app.</p>
        </div>
        <div class="profile-demo" aria-hidden="true">
          {profiles.map((p, i) => (
            <div class:list={['profile', { on: i === 0 }]} data-prof-card>
              <div class="p-app"><img src={p.icon.src} alt="" class:list={[{ fav: p.fav }]} /><div><b>{p.app}</b><span>{p.hint}</span></div></div>
              <div class="p-keys">{p.keys.map((k) => <span>{k}</span>)}</div>
            </div>
          ))}
          <div class="p-dots">{profiles.map((_, i) => <i class:list={[{ on: i === 0 }]} data-profile-dot></i>)}</div>
        </div>
      </article>

      <!-- scenes -->
      <article class="card b-scenes reveal" data-scenes style="--d:80ms">
        <div class="b-copy">
          <h3 class="h3">Scenes: one tap, many steps</h3>
          <p class="muted">Try one. Scenes can set any control, open a tile, run a Shortcut or start the sleep timer.</p>
        </div>
        <div class="scene-btns">
          {scenes.map((s) => (
            <button data-scene={s.id} data-b={s.b} data-warm={s.warm} style={`--sc:${s.color}`}>
              <span><Icon name={s.icon} size={16} /></span>{s.name}
            </button>
          ))}
        </div>
        <div class="scene-stage">
          <div class="mini-tv" data-mini>
            <Image src={macHomeTv} alt="" widths={[520]} sizes="260px" />
            <i class="warm"></i>
          </div>
          {scenes.map((s) => (
            <ol class="steps" data-steps={s.id} hidden>
              {s.steps.map((st) => <li><Icon name="check" size={13} /> {st}</li>)}
            </ol>
          ))}
          <p class="steps-idle" data-steps-idle>Pick a scene to run it here.</p>
        </div>
      </article>

      <!-- now playing -->
      <article class="card b-np reveal">
        <div class="np">
          <div class="np-art"><Icon name="music" size={26} /></div>
          <div class="np-meta"><b>Night Drive</b><span>Coastal FM · Music</span></div>
          <div class="np-bar"><i></i></div>
          <div class="np-time"><span>1:12</span><span>−2:41</span></div>
          <div class="np-ctl"><Icon name="skip-back" size={18} /><span class="np-play"><Icon name="pause" size={18} /></span><Icon name="skip-fwd" size={18} /></div>
        </div>
        <div class="b-copy">
          <h3 class="h3">Now Playing</h3>
          <p class="muted">Artwork, a scrubber and transport for whatever the Mac is playing: Music, Spotify, Podcasts or a browser tab.</p>
        </div>
      </article>

      <!-- switcher -->
      <article class="card b-switch reveal" style="--d:80ms">
        <div class="sw-grid" aria-hidden="true">
          <div><Icon name="tv" size={26} /><b>{site.name}</b><span>Home</span></div>
          <div><img src={youtube.src} alt="" class="fav" /><b>YouTube</b><span>in Safari</span></div>
          <div><img src={tvIcon.src} alt="" /><b>TV</b></div>
          <div><img src={twitch.src} alt="" class="fav" /><b>Twitch</b><span>in Safari</span></div>
        </div>
        <div class="b-copy">
          <h3 class="h3">Switch apps and tabs</h3>
          <p class="muted">Double-press Home for a grid of running apps and open browser tabs. Tap to switch, hold to quit or close.</p>
        </div>
      </article>

      <!-- sleep timer -->
      <article class="card b-sleep reveal" style="--d:160ms">
        <div class="ring" aria-hidden="true">
          <svg viewBox="0 0 120 120"><circle cx="60" cy="60" r="52" /><circle class="prog" cx="60" cy="60" r="52" /></svg>
          <div><b>29:58</b><span>then sleep</span></div>
        </div>
        <div class="b-copy">
          <h3 class="h3">Sleep timer</h3>
          <p class="muted">15 minutes to two hours, or the end of this track. Then it pauses, and can sleep the display or the Mac.</p>
        </div>
      </article>

      <!-- controller -->
      <article class="card b-pad reveal">
        <div class="b-copy">
          <h3 class="h3">Game controllers welcome</h3>
          <p class="muted">PlayStation, Xbox and MFi controllers drive the launcher. In a game, only the Home button belongs to {site.name}.</p>
        </div>
        <dl class="map">
          <div><dt>D-pad / stick</dt><dd>Navigate</dd></div>
          <div><dt>A</dt><dd>Select</dd></div>
          <div><dt>B</dt><dd>Back</dd></div>
          <div><dt>X</dt><dd>Play/Pause</dd></div>
          <div><dt>L1 / R1</dt><dd>Previous / Next</dd></div>
          <div><dt>Menu</dt><dd>Tile options</dd></div>
        </dl>
      </article>

      <!-- more -->
      <article class="card b-more reveal" style="--d:80ms">
        <h3 class="h3">And a long tail of thoughtful extras</h3>
        <div class="more-chips">
          {more.map(([icon, label]) => <span class="chip"><Icon name={icon} size={15} /> {label}</span>)}
        </div>
        <a class="more-link" href="/features">See every feature <Icon name="arrow-right" size={16} /></a>
      </article>
    </div>
  </section>

  <!-- ============ ASK ============ -->
  <section class="section ask-sec">
    <div class="ask-glow" aria-hidden="true"></div>
    <div class="wrap split rev">
      <div class="copy">
        <span class="eyebrow reveal"><Icon name="sparkles" size={14} /> Apple Intelligence</span>
        <h2 class="h2 reveal">Just <span class="grad">ask.</span></h2>
        <p class="lede reveal">
          Say what you want in plain words. {site.name} turns it into its own real actions, and checks every name against what is actually on your Mac, so it cannot invent anything.
        </p>
        <ul class="ticks">
          <li class="reveal"><Icon name="check" size={18} /> <span><b>Private by design.</b> It all runs on the Mac, so Android phones get it too.</span></li>
          <li class="reveal"><Icon name="check" size={18} /> <span><b>Describe a scene</b> and get a name, icon and steps to review.</span></li>
          <li class="reveal"><Icon name="check" size={18} /> <span><b>Smart Clipboard</b> turns a pasted link, address or tracking number into the next step on the TV.</span></li>
          <li class="reveal"><Icon name="check" size={18} /> <span><b>Organize Tiles</b> suggests clean names and tidy rows. Nothing changes until you apply it.</span></li>
        </ul>
        <p class="req reveal">Needs macOS 26 or later on Apple silicon with Apple Intelligence on. Everything else runs on Sonoma.</p>
      </div>
      <div class="ask-visual reveal">
        <div class="ask-panel" data-ask>
          <div class="ask-title">Ask {site.name}</div>
          <div class="ask-field"><Icon name="sparkles" size={18} /><span data-ask-text></span><i class="caret"></i></div>
          <ul class="ask-actions" data-ask-actions></ul>
        </div>
        <div class="phone ask-phone"><div class="screen"><Image src={pAsk} alt="The Ask sheet on the phone remote, with a text field, a microphone button and example requests." widths={[360, 600]} sizes="230px" /></div></div>
      </div>
    </div>
  </section>

  <!-- ============ PRIVACY ============ -->
  <section class="section">
    <div class="wrap center">
      <span class="eyebrow reveal">Private by architecture</span>
      <h2 class="h2 reveal">No cloud. No account.<br />Nothing in between.</h2>
      <p class="lede reveal">Your phone talks straight to your Mac over your own network or Bluetooth. After a 6-digit pairing code, every message is end-to-end encrypted with keys only those two devices hold.</p>
    </div>
    <div class="wrap">
      <div class="link-diagram card reveal">
        <div class="node"><span><Icon name="phone" size={30} /></span><b>Your phone</b><small>iPhone or Android</small></div>
        <div class="beam" aria-hidden="true">
          <i></i><i></i><i></i>
          <span class="beam-lock"><Icon name="lock" size={18} /></span>
        </div>
        <div class="node"><span><Icon name="tv" size={30} /></span><b>Your Mac</b><small>{site.minMacOS} or later</small></div>
        <p class="beam-cap">Wi-Fi or Bluetooth LE · end-to-end encrypted</p>
        <div class="nocloud"><Icon name="cloud-off" size={18} /> No relay server. No sign-in. No analytics.</div>
      </div>
      <div class="trio tight">
        <div class="reveal"><Icon name="shield" size={22} /><h3 class="h3">Modern cryptography</h3><p class="muted">X25519 key agreement and ChaCha20-Poly1305 encryption, with the pairing code mixed into the first handshake.</p></div>
        <div class="reveal" style="--d:80ms"><Icon name="sparkles" size={22} /><h3 class="h3">On-device intelligence</h3><p class="muted">Ask, Smart Clipboard and Organize Tiles use Apple Intelligence on your Mac. Requests never go to us.</p></div>
        <div class="reveal" style="--d:160ms"><Icon name="lock" size={22} /><h3 class="h3">You hold the keys</h3><p class="muted">See every paired remote in Settings and remove any of them. Turn off new pairings entirely when you are done.</p></div>
      </div>
      <p class="center more-privacy reveal"><a href="/privacy">How {site.name} handles your data <Icon name="arrow-right" size={15} /></a></p>
    </div>
  </section>

  <!-- ============ STEPS ============ -->
  <section class="section steps-sec">
    <div class="wrap center">
      <span class="eyebrow reveal">Two minutes</span>
      <h2 class="h2 reveal">Set up before the popcorn's done.</h2>
    </div>
    <ol class="wrap howto">
      <li class="card reveal">
        <span class="n">1</span>
        <h3 class="h3">Install {site.name} on your Mac</h3>
        <p class="muted">Open it, and it walks you through the permissions it needs so your phone can find it and send keys.</p>
        <div class="how-art"><span class="mini-tile" style="--a:#048ffe"></span><span class="mini-tile on" style="--a:#f80135"></span><span class="mini-tile" style="--a:#8936b4"></span></div>
      </li>
      <li class="card reveal" style="--d:90ms">
        <span class="n">2</span>
        <h3 class="h3">Get the free remote</h3>
        <p class="muted">Install the remote on iPhone or Android. Your Mac appears on its own; no address to type.</p>
        <div class="how-art"><span class="found"><Icon name="wifi" size={16} /> Living Room <em>Connect</em></span></div>
      </li>
      <li class="card reveal" style="--d:180ms">
        <span class="n">3</span>
        <h3 class="h3">Enter the 6-digit code</h3>
        <p class="muted">Your Mac shows a code, you type it once, and the two are paired. From then on the remote reconnects by itself.</p>
        <div class="how-art code"><b>4</b><b>8</b><b>2</b><b>9</b><b>1</b><b>6</b></div>
      </li>
    </ol>
  </section>

  <!-- ============ PRICING TEASER ============ -->
  <section class="section">
    <div class="wrap price-teaser card reveal">
      <div>
        <span class="eyebrow">Pricing</span>
        <h2 class="h2">Pay once.<br />Own it.</h2>
        <p class="lede">No subscription. The Mac app is a one-time purchase with a {pricing.trialDays}-day free trial, and the remote is free on every phone in the house.</p>
        <div class="cta-row left">
          <a class="btn btn-primary" href="/download">Start free trial</a>
          <a class="btn btn-ghost" href="/pricing">See pricing</a>
        </div>
      </div>
      <div class="price-tag">
        <span class="amount"><sup>{pricing.currency}</sup>{direct.price}</span>
        <span class="once">one-time · every feature</span>
        <ul>
          {direct.features.slice(0, 5).map((f) => <li><Icon name="check" size={16} /> {f}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ FAQ TEASER ============ -->
  <section class="section faq-teaser">
    <div class="wrap narrow">
      <div class="center">
        <span class="eyebrow reveal">Questions</span>
        <h2 class="h2 reveal">Good to know.</h2>
      </div>
      <div class="reveal"><FaqList items={topFaqs} /></div>
      <p class="center more-privacy"><a href="/faq">Read the full FAQ <Icon name="arrow-right" size={15} /></a></p>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="final">
    <div class="final-glow" aria-hidden="true"></div>
    <div class="wrap center">
      <h2 class="display reveal">Lean back.<br /><span class="grad">Your Mac's got this.</span></h2>
      <div class="cta-row reveal">
        <a class="btn btn-primary" href="/download"><Icon name="apple" size={18} /> Download for Mac</a>
        <a class="btn btn-ghost" href="/download#remote"><Icon name="phone" size={18} /> Get the remote</a>
      </div>
      <p class="fine reveal">{site.minMacOS} or later · iPhone and Android</p>
    </div>
  </section>
</Base>

<script>
  // Screenshot tabs
  const tabs = [...document.querySelectorAll<HTMLElement>('[data-shot-tab]')];
  const shots = [...document.querySelectorAll<HTMLElement>('[data-shot]')];
  tabs.forEach((t) =>
    t.addEventListener('click', () => {
      tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
      shots.forEach((s) => s.classList.toggle('on', s.dataset.shot === t.dataset.shotTab));
    }),
  );

  // Per-app remote card: rotate through profiles
  const profs = [...document.querySelectorAll<HTMLElement>('[data-prof-card]')];
  const dots = [...document.querySelectorAll<HTMLElement>('[data-profile-dot]')];
  let pi = 0;
  if (profs.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    setInterval(() => {
      pi = (pi + 1) % profs.length;
      profs.forEach((p, i) => p.classList.toggle('on', i === pi));
      dots.forEach((d, i) => d.classList.toggle('on', i === pi));
    }, 3200);
  }

  // Scenes card: run the tapped scene step by step
  const scenesCard = document.querySelector<HTMLElement>('[data-scenes]');
  if (scenesCard) {
    const mini = scenesCard.querySelector<HTMLElement>('[data-mini]')!;
    const idle = scenesCard.querySelector<HTMLElement>('[data-steps-idle]')!;
    const lists = [...scenesCard.querySelectorAll<HTMLElement>('[data-steps]')];
    let timers: number[] = [];
    scenesCard.querySelectorAll<HTMLElement>('[data-scene]').forEach((btn) => {
      btn.addEventListener('click', () => {
        timers.forEach(clearTimeout);
        timers = [];
        scenesCard.querySelectorAll('[data-scene]').forEach((b) => b.classList.toggle('on', b === btn));
        idle.hidden = true;
        lists.forEach((l) => {
          l.hidden = l.dataset.steps !== btn.dataset.scene;
          l.querySelectorAll('li').forEach((li) => li.classList.remove('done'));
        });
        const list = lists.find((l) => l.dataset.steps === btn.dataset.scene)!;
        [...list.children].forEach((li, i) => {
          timers.push(window.setTimeout(() => li.classList.add('done'), 250 + i * 420));
        });
        timers.push(
          window.setTimeout(() => {
            mini.style.setProperty('--b', btn.dataset.b!);
            mini.style.setProperty('--warm', btn.dataset.warm!);
          }, 600),
        );
      });
    });
  }

  // Ask panel: type a request, then show the actions it became
  const ask = document.querySelector<HTMLElement>('[data-ask]');
  if (ask) {
    const textEl = ask.querySelector<HTMLElement>('[data-ask-text]')!;
    const list = ask.querySelector<HTMLElement>('[data-ask-actions]')!;
    const demos: { q: string; a: string[] }[] = [
      { q: 'Put on Netflix and dim the screen', a: ['Open Netflix', 'Brightness to 35%'] },
      { q: 'Sleep in 30 minutes', a: ['Sleep timer: 30 min, then sleep display'] },
      { q: 'Movie night', a: ['Run scene “Movie Night”'] },
      { q: 'Make a scene for game night', a: ['Draft scene “Game Night”', 'Review 4 steps, then Save'] },
    ];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    let running = false;
    async function loop() {
      if (running) return;
      running = true;
      for (let i = 0; ; i = (i + 1) % demos.length) {
        const d = demos[i];
        list.innerHTML = '';
        textEl.textContent = '';
        ask.classList.remove('done');
        if (reduced) textEl.textContent = d.q;
        else for (const ch of d.q) { textEl.textContent += ch; await wait(34 + Math.random() * 40); }
        await wait(450);
        ask.classList.add('done');
        for (const a of d.a) {
          const li = document.createElement('li');
          li.textContent = a;
          list.appendChild(li);
          await wait(260);
        }
        await wait(reduced ? 6000 : 2600);
      }
    }
    new IntersectionObserver((es, o) => { if (es[0].isIntersecting) { o.disconnect(); loop(); } }, { threshold: 0.3 }).observe(ask);
  }
</script>

