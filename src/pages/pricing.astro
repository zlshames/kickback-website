---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import FaqList from '../components/FaqList.astro';
import { site, pricing, faqs } from '../data/site';

const buying = faqs.find((g) => g.group === 'Buying')!.items;
---
<Base title="Pricing" description={`${site.name} is a one-time purchase with a free trial. The phone remote is free.`}>
  <section class="page-hero">
    <div class="aurora" aria-hidden="true"></div>
    <div class="wrap">
      <span class="eyebrow reveal">Pricing</span>
      <h1 class="display reveal">Pay once.<br /><span class="grad">Lean back for good.</span></h1>
      <p class="lede reveal">No subscription and no account. Buy the Mac app once, and put the free remote on every phone in the house.</p>
    </div>
  </section>

  <section class="wrap plans">
    {pricing.plans.map((p, i) => (
      <article class:list={['plan', 'reveal', { featured: p.featured }]} style={`--d:${i * 90}ms`}>
        {p.badge && <span class="badge">{p.badge}</span>}
        <h2>{p.name}</h2>
        <p class="blurb">{p.blurb}</p>
        <div class="price">
          {p.price === 0 ? <span class="amt">Free</span> : <span class="amt"><sup>{pricing.currency}</sup>{p.price}</span>}
          <span class="cad">{p.cadence}</span>
        </div>
        <a class:list={['btn', p.featured ? 'btn-primary' : 'btn-ghost']} href={p.cta.href}>{p.cta.label}</a>
        {p.featured && <p class="trial">{pricing.trialDays} days free, every feature unlocked</p>}
        <ul>
          {p.features.map((f) => <li><Icon name="check" size={17} /> {f}</li>)}
        </ul>
      </article>
    ))}
  </section>

  <section class="wrap assurances">
    <div class="reveal"><Icon name="lock" size={20} /><div><b>No account needed</b><span>Nothing to sign up for, on the Mac or the phone.</span></div></div>
    <div class="reveal" style="--d:80ms"><Icon name="cloud-off" size={20} /><div><b>No recurring fees</b><span>There is no server to pay for, so there is no subscription.</span></div></div>
    <div class="reveal" style="--d:160ms"><Icon name="phone" size={20} /><div><b>Unlimited remotes</b><span>Pair every iPhone and Android phone in the house.</span></div></div>
  </section>

  <section class="section tight">
    <div class="wrap narrow">
      <div class="center head"><h2 class="h2 reveal">Buying questions</h2></div>
      <div class="reveal"><FaqList items={buying} /></div>
      <p class="center more"><a href="/faq">All questions <Icon name="arrow-right" size={15} /></a></p>
    </div>
  </section>
</Base>

<style>
  .plans { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; align-items: stretch; margin-top: 20px; max-width: 900px; }
  .plan {
    position: relative; display: flex; flex-direction: column; padding: 34px 30px; border-radius: 30px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.02)); border: 1px solid var(--line);
  }
  .plan.featured {
    background:
      linear-gradient(180deg, #131626, #0b0c14) padding-box,
      linear-gradient(140deg, #8fd0ff, #7ea8ff 35%, #b184ff 70%, rgba(255, 255, 255, 0.15)) border-box;
    border: 1.5px solid transparent;
    box-shadow: 0 40px 100px -40px rgba(126, 130, 255, 0.75);
    transform: translateY(-14px);
  }
  .plan.featured.reveal:not(.in) { transform: translateY(14px) scale(0.985); }
  .badge { position: absolute; top: -13px; left: 30px; padding: 4px 13px; border-radius: 999px; background: var(--grad); color: #06070b; font-size: 0.76rem; font-weight: 700; letter-spacing: 0.02em; }
  h2 { font-size: 1.45rem; letter-spacing: -0.025em; }
  .blurb { color: var(--muted); font-size: 0.95rem; margin-top: 8px; min-height: 4.4em; }
  .price { display: flex; align-items: baseline; gap: 12px; margin: 18px 0 24px; flex-wrap: wrap; }
  .amt { font-size: 4rem; font-weight: 750; letter-spacing: -0.06em; line-height: 1; }
  .amt sup { font-size: 0.4em; vertical-align: top; position: relative; top: 0.3em; margin-right: 3px; color: var(--muted); letter-spacing: 0; }
  .cad { color: var(--muted); font-size: 0.92rem; }
  .plan .btn { width: 100%; }
  .trial { text-align: center; font-size: 0.82rem; color: var(--muted); margin-top: 10px; }
  .plan ul { margin-top: 26px; padding-top: 24px; border-top: 1px solid var(--line); display: grid; gap: 12px; }
  .plan li { display: flex; gap: 11px; font-size: 0.96rem; color: #d3d6e0; align-items: flex-start; }
  .plan li :global(svg) { color: var(--good); flex: none; margin-top: 3px; }
  @media (max-width: 940px) { .plans { grid-template-columns: 1fr; max-width: 520px; } .plan.featured { transform: none; order: -1; } .blurb { min-height: 0; } }

  .assurances { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 44px; max-width: 900px; }
  .assurances > div { display: flex; gap: 14px; padding: 20px 22px; border-radius: 20px; border: 1px solid var(--line); background: var(--surface); }
  .assurances :global(svg) { color: var(--accent); flex: none; margin-top: 3px; }
  .assurances b { display: block; font-size: 0.98rem; }
  .assurances span { color: var(--muted); font-size: 0.88rem; }
  @media (max-width: 860px) { .assurances { grid-template-columns: 1fr; } }

  .tight { padding-top: clamp(60px, 8vw, 100px); }
  .narrow { max-width: 820px; }
  .head { margin-bottom: 36px; }
  .more { margin-top: 32px; }
  .more a { display: inline-flex; align-items: center; gap: 8px; color: var(--accent); font-weight: 600; }
</style>
